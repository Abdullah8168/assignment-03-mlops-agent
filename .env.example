# Copy to .env and fill in. .env is gitignored - never commit real secrets.

# --- LLM -------------------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_LLM_BACKEND=claude          # claude | offline (rule-based planner, no API key needed)
AGENT_LLM_MODEL=claude-opus-5-5
AGENT_LLM_EFFORT=medium
# Optional: protect the agent API with a shared secret (send as X-API-Key header)
AGENT_API_KEY=

# --- MLflow ----------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=breast-cancer-classifier
REGISTERED_MODEL_NAME=breast-cancer-classifier

# --- Airflow 3 -------------------------------------------------------
AIRFLOW_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=change-me
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string
AIRFLOW_APPROVED_DAGS=ml_training_pipeline

# --- Kubernetes ------------------------------------------------------
K8S_NAMESPACE=ml-serving
K8S_APPROVED_NAMESPACES=ml-serving
K8S_APP_LABEL=app=prediction-api
K8S_MUTABLE_DEPLOYMENTS=prediction-api

# --- Policy ----------------------------------------------------------
MODEL_FRESHNESS_DAYS=30
F1_QUALITY_THRESHOLD=0.90
TOOL_TIMEOUT_SECONDS=20

# --- Host ports (change if 5000/8080 are taken by another project) ---
MLFLOW_PORT=5000
AIRFLOW_PORT=8080
